# Database Configuration
DATABASE_URL=postgres://postgres:${DATABASE_PASSWORD}@127.0.0.1:5432/postgres
DATABASE_PASSWORD=

# Redis Configuration
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:4096/
REDIS_PASSWORD=

# Test Redis Configuration (http_service 集成测试使用, 建议独立 DB index/实例)
TEST_REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:4096/15

# S3 Configuration
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# App Configuration
APP_DOMAIN=

# SQLCipher 下发密钥托管主密钥(64 hex = 32字节, AES-256-GCM 加密用)
# 以下为示例值，务必替换为随机生成的真实值: openssl rand -hex 32
SQLITE_KEY_MASTER=2aa7da612c80bd9cec448f17b84b9d266faccf72c0aa747bc1519f5b0a69a71b

# QUIC Server (外网) / 内部 QUIC 配置
QUIC_SERVER_ADDRESS=0.0.0.0:4433
QUIC_SERVER_NAME=127.0.0.1:4433
QUIC_NODE_ADDRESS=127.0.0.1:4433

INTERNAL_QUIC_SERVER_ADDRESS=127.0.0.1:4434
INTERNAL_QUIC_SERVER_NAME=INTERNAL_SERVER_1
INTERNAL_QUIC_NODE_ADDRESS=127.0.0.1:4434

# Email (Aliyun DirectMail) Configuration
EMAIL_ENABLED=false
EMAIL_ACCESS_KEY_ID=
EMAIL_ACCESS_KEY_SECRET=
EMAIL_ACCOUNT_NAME=noreply@onlytalk.cn
