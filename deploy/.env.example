# ============================================================
# only-talk-rs 整栈部署环境变量模板
# 复制为 .env 并填入真实值（.env 不入库，敏感信息勿提交！）
# 数据库/缓存/对象存储的主机名使用 compose 服务名，勿用 127.0.0.1
# ============================================================

# ---------------- 镜像 ----------------
# 与 GitHub Actions CD 推送地址保持一致：ghcr.io/<owner>/only-talk-rs
IMAGE=ghcr.io/nicolastinger/only-talk-rs
IMAGE_TAG=latest

# ---------------- PostgreSQL ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_db
DATABASE_URL=postgres://postgres:change-me@postgres:5432/app_db

# ---------------- Redis ----------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
TEST_REDIS_URL=redis://:change-me@redis:6379/15

# ---------------- MinIO / S3 ----------------
MINIO_USER_NAME=minioadmin
MINIO_USER_PASSWORD=change-me
MINIO_BROWSER_REDIRECT_URL=https://your-domain.com/minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ---------------- 应用 ----------------
APP_DOMAIN=https://your-domain.com
SERVER_ADDRESS=0.0.0.0:8443

# ---------------- 证书（certbot 容器） ----------------
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# ---------------- 邮件（可选，注册验证码依赖） ----------------
EMAIL_ENABLED=false
EMAIL_ACCESS_KEY_ID=
EMAIL_ACCESS_KEY_SECRET=
EMAIL_ACCOUNT_NAME=noreply@your-domain.com
